#!/bin/bash
# =================================================================================================
# chronos-gn
# Description: Automated macOS Time Machine setup including sparsebundle creation, configuration,
#              and persistent reconnection to a network-hosted backup share.
# Usage: bash chronos-gn --url smb://host/share [options]
# -------------------------------------------------------------------------------------------------

set -euo pipefail
IFS=$'\n\t'

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
readonly APP_NAME="chronos-gn"
readonly VERSION="3.0.0"
readonly LEGACY_PASSWORD_ENV_VAR="CHRONOS_ENCRYPTION_PASSWORD"

# -----------------------------------------------
# Script Metadata & Defaults
# -----------------------------------------------
DEBUG=0
VERBOSE=0
ASSUME_YES=0
SETUP_LAUNCHAGENT=1
LAUNCHAGENT_ONLY=0
START_FIRST_BACKUP=1
ENABLE_ENCRYPTION=1
FORCE_CLEAN_PARTIAL=0
MIGRATE_LEGACY=1
MIGRATION_APPROVED=0
LAUNCH_INTERVAL=300
GUI_MOUNT_COOLDOWN=1800
BACKUP_ALERT_DAYS=7
SUPPRESS_MOUNT_WINDOW=1
SIZE="2000g"
FILESYSTEM="APFS"
DESTINATION="/Volumes/TimeMachine"
NETWORK_URL=""
VOLUME_NAME="Time Machine Backups"
LABEL_PREFIX="io.github.andrewkc98"
HELPER_DIR="/usr/local/lib/chronos-gn"
PASSWORD_ENV_VAR="CHRONOS_GN_ENCRYPTION_PASSWORD"
ENCRYPTION_PASSWORD=""

CONFIG_FILE=""
LEGACY_PASSWORD_WARNED=0
LOG_FILE=""
LOG_FILE_EXPLICIT=0
BOOTSTRAP_LOG=""

CONSOLE_USER=""
CONSOLE_UID=""
CONSOLE_GROUP=""
CONSOLE_HOME=""
COMPUTER_NAME=""
HARDWARE_UUID=""
PRIMARY_MAC=""
BUNDLE_NAME=""
BUNDLE_PATH=""
TMP_DIR=""
TMP_BUNDLE=""
STAGING_BUNDLE=""
MACHINE_ID_PLIST=""
LAUNCH_AGENT_LABEL=""
LAUNCH_AGENT_PATH=""
HELPER_SCRIPT_PATH=""
MONITOR_SCRIPT_PATH=""
LAUNCH_LOG_DIR=""
SHARE_HOST=""
SHARE_PORT=""
IMAGE_DEVICE=""
IMAGE_MOUNT_POINT=""
EXPECTED_IMAGE_MOUNT_POINT=""
MOUNTED_IMAGE_IN_RUN=0
RUN_SUCCEEDED=0
SUMMARY_BACKUP_STATUS="not-requested"
SUMMARY_LAUNCHAGENT_STATUS="not-requested"
SUMMARY_BUNDLE_STATUS="unknown"
SUMMARY_MIGRATION_STATUS="not-needed"
SUMMARY_KEYCHAIN_STATUS="not-applicable"
SUMMARY_MOUNT_WINDOW_STATUS="not-applicable"

LEGACY_LAUNCH_AGENT_LABEL=""
LEGACY_LAUNCH_AGENT_PATH=""
LEGACY_HELPER_DIR="/usr/local/lib/chronos"
LEGACY_LAUNCH_LOG_DIR=""

INSTALL_LOCK_DIR=""

# -----------------------------------------------
# Usage
# -----------------------------------------------
usage() {
    cat <<EOF
${APP_NAME} ${VERSION}

Usage: ${SCRIPT_NAME} --url smb://host/share [options]

Core options:
  -u, --url URL                   smb:// or afp:// URL used to mount the share (required)
  -s, --size SIZE                 Sparsebundle size, e.g. 2000g (default: 2000g)
  -d, --destination PATH          Mounted network share path (default: /Volumes/TimeMachine)
  -f, --filesystem FS             APFS, Case-sensitive APFS, Journaled HFS+, or Case-sensitive Journaled HFS+
  -n, --name NAME                 Backup volume name inside the sparsebundle
      --no-encryption             Create the sparsebundle without AES-256 encryption
      --password-env VAR          Environment variable containing the encryption password

Configuration:
  -c, --config PATH               Read settings from a config file
      --label-prefix PREFIX       Reverse-DNS prefix for the LaunchAgent label
                                  (default: ${LABEL_PREFIX})
      --helper-dir PATH           Directory for generated helper scripts
                                  (default: ${HELPER_DIR})

Behavior:
      --no-launchagent            Skip LaunchAgent helper setup
      --launchagent-only          Update only the LaunchAgent, helper, and monitor assets
      --launch-interval SECONDS   Remount recheck interval for the persistent monitor (default: 300)
      --gui-mount-cooldown SECS   After an unanswered disk image password prompt, wait this
                                  long before asking again (default: 1800, 0 disables)
      --backup-alert-days DAYS    Alert when the newest Time Machine backup is older than
                                  this many days (default: 7, 0 disables)
      --keep-mount-window         Leave macOS to open a Finder window every time the
                                  backup volume mounts. By default ${APP_NAME} turns that
                                  off by setting auto-open-rw-root/auto-open-ro-root in
                                  the com.apple.frameworks.diskimages preference domain
                                  for the console user; the previous values are recorded
                                  and restored by ${APP_NAME}-uninstall.
      --no-start-backup           Skip starting the first backup
      --force-clean-partial       Remove known partial bundles without prompting
      --no-migrate                Do not migrate a legacy 'chronos' install if one is found
  -y, --yes                       Auto-confirm destructive cleanup and migration prompts
  -v, --verbose                   Print INFO/WARN logs to stdout
      --debug                     Enable debug logging
      --log-file PATH             Override log file path
  -h, --help                      Show this help

Configuration file search order (first match wins, CLI flags always win over it):
  --config PATH
  \$CHRONOS_GN_CONFIG
  \${XDG_CONFIG_HOME:-\$HOME/.config}/${APP_NAME}/config
  /etc/${APP_NAME}/config

Environment:
  CHRONOS_GN_ENCRYPTION_PASSWORD  Password used when encryption is enabled
  CHRONOS_GN_CONFIG               Path to a configuration file
EOF
}
# -----------------------------------------------
# Helpers
# -----------------------------------------------
timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}

escape_for_applescript() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

log() {
    local level="$1"
    shift
    local message="$*"

    # LOG_FILE is empty only in the narrow window before init_bootstrap_log runs.
    if [[ -n "$LOG_FILE" ]]; then
        printf '[%s] [%s] %s\n' "$(timestamp)" "$level" "$message" >>"$LOG_FILE"
    fi

    if [[ "$DEBUG" -eq 1 || "$VERBOSE" -eq 1 || "$level" == "ERROR" || "$level" == "WARN" ]]; then
        printf '[%s] [%s] %s\n' "$(timestamp)" "$level" "$message" >&2
    fi
}

info() {
    log "INFO" "$*"
}

warn() {
    log "WARN" "$*"
}

error() {
    log "ERROR" "$*"
}

die() {
    error "$*"
    exit 1
}

on_error() {
    local exit_code="$1"
    local line_no="$2"
    error "Command failed at line ${line_no} with exit code ${exit_code}."
    exit "$exit_code"
}

# -----------------------------------------------
# Cleanup
# -----------------------------------------------
cleanup() {
    local exit_code="$?"

    if [[ "$MOUNTED_IMAGE_IN_RUN" -eq 1 && "$RUN_SUCCEEDED" -ne 1 ]]; then
        if [[ -n "${IMAGE_MOUNT_POINT:-}" ]] && is_mountpoint "$IMAGE_MOUNT_POINT"; then
            info "Detaching sparsebundle mounted at ${IMAGE_MOUNT_POINT}."
            detach_image_mount "$IMAGE_MOUNT_POINT" || warn "Unable to detach ${IMAGE_MOUNT_POINT}; detach manually if needed."
        elif [[ -n "${IMAGE_DEVICE:-}" ]]; then
            info "Detaching sparsebundle device ${IMAGE_DEVICE}."
            hdiutil detach "$IMAGE_DEVICE" -quiet >/dev/null 2>&1 || warn "Unable to detach ${IMAGE_DEVICE}; detach manually if needed."
        fi
    fi

    if [[ -n "${TMP_BUNDLE:-}" && -d "${TMP_BUNDLE}" ]]; then
        info "Removing temporary sparsebundle ${TMP_BUNDLE}."
        rm -rf "$TMP_BUNDLE" || warn "Unable to remove temporary sparsebundle ${TMP_BUNDLE}."
    fi

    if [[ -n "${TMP_DIR:-}" && -d "${TMP_DIR}" ]]; then
        rm -rf "$TMP_DIR" >/dev/null 2>&1 || true
    fi

    unset ENCRYPTION_PASSWORD || true

    # Mirrors the generated helper's cleanup_lock: only the process that created
    # the lock may remove it, so a lock reaped from under a still-running sibling
    # invocation (e.g. after a stale-lock takeover raced this same run) is never
    # deleted by the wrong owner.
    if [[ -n "${INSTALL_LOCK_DIR:-}" && -d "${INSTALL_LOCK_DIR}" ]]; then
        local lock_owner_pid=""
        lock_owner_pid="$(cat "${INSTALL_LOCK_DIR}/pid" 2>/dev/null || true)"
        if [[ "$lock_owner_pid" == "$$" ]]; then
            rm -rf "$INSTALL_LOCK_DIR" >/dev/null 2>&1 || true
        fi
    fi

    if [[ "$exit_code" -eq 0 ]]; then
        info "${APP_NAME} completed successfully."
    else
        error "${APP_NAME} exited with failure status ${exit_code}."
    fi

    # Anything still buffered means we exited before finalize_log_file, i.e. during
    # argument or environment validation. Those errors already went to stderr, so
    # the buffer is only worth keeping when debugging.
    if [[ -n "${BOOTSTRAP_LOG:-}" && -f "${BOOTSTRAP_LOG}" ]]; then
        if [[ "$exit_code" -ne 0 && "$DEBUG" -eq 1 ]]; then
            printf 'Early-run log retained at %s\n' "$BOOTSTRAP_LOG" >&2
        else
            rm -f "$BOOTSTRAP_LOG" >/dev/null 2>&1 || true
        fi
    fi
}

trap 'on_error $? $LINENO' ERR
trap cleanup EXIT

run_as_root() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

run_in_console_user_context() {
    if [[ "$(id -u)" -eq "$CONSOLE_UID" ]]; then
        "$@"
    elif [[ "$(id -u)" -eq 0 ]]; then
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" "$@"
    else
        "$@"
    fi
}
retry() {
    local attempts="$1"
    local delay_seconds="$2"
    shift 2

    local attempt=1
    until "$@"; do
        if [[ "$attempt" -ge "$attempts" ]]; then
            return 1
        fi
        warn "Attempt ${attempt}/${attempts} failed for: $*. Retrying in ${delay_seconds}s."
        sleep "$delay_seconds"
        attempt=$((attempt + 1))
    done
}

is_mountpoint() {
    local target="$1"
    mount | awk -v t="$target" '{ i = index($0, " on /"); if (i == 0) next; s = substr($0, i + 4); sub(/ \([^)]*\)$/, "", s); if (s == t) found = 1 } END { exit found ? 0 : 1 }'
}

wait_for_mountpoint() {
    local target="$1"
    local timeout="$2"
    local elapsed=0

    while [[ "$elapsed" -lt "$timeout" ]]; do
        if is_mountpoint "$target"; then
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    return 1
}

confirm_action() {
    local prompt="$1"

    if [[ "$ASSUME_YES" -eq 1 ]]; then
        info "Auto-confirmed: ${prompt}"
        return 0
    fi

    if [[ ! -t 0 ]]; then
        return 1
    fi

    read -r -p "${prompt} [y/N]: " reply
    [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]
}

# -----------------------------------------------
# Installer lock
# -----------------------------------------------
# Guards against two concurrent chronos-gn runs racing the same sparsebundle,
# share mount, or Time Machine destination. Deliberately mirrors the generated
# helper's own lock (mkdir as the atomic primitive, a pid file inside, cleanup()
# only removes it if the pid file still names this process).
acquire_installer_lock() {
    INSTALL_LOCK_DIR="/tmp/${APP_NAME}.install.lock"

    if mkdir "$INSTALL_LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" >"${INSTALL_LOCK_DIR}/pid"
        return 0
    fi

    local existing_pid=""
    existing_pid="$(cat "${INSTALL_LOCK_DIR}/pid" 2>/dev/null || true)"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" 2>/dev/null; then
        die "Another ${APP_NAME} run (pid ${existing_pid}) is already in progress."
    fi

    warn "Removing stale installer lock at ${INSTALL_LOCK_DIR}."
    rm -rf "$INSTALL_LOCK_DIR" || true

    if mkdir "$INSTALL_LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" >"${INSTALL_LOCK_DIR}/pid"
        return 0
    fi

    die "Unable to acquire installer lock at ${INSTALL_LOCK_DIR}."
}

# -----------------------------------------------
# Logging bootstrap
# -----------------------------------------------
# The real log location depends on the console user's home directory, which is
# only known after prepare_context(). Until then everything is buffered into an
# unpredictable mktemp file, which is then flushed into the final log.
init_bootstrap_log() {
    BOOTSTRAP_LOG="$(mktemp "/tmp/${APP_NAME}-bootstrap.XXXXXX")"
    chmod 0600 "$BOOTSTRAP_LOG"
    LOG_FILE="$BOOTSTRAP_LOG"
}

dir_is_world_writable() {
    local dir="$1"
    local mode

    mode="$(stat -f '%Lp' "$dir" 2>/dev/null || true)"
    [[ -n "$mode" ]] || return 1
    (( (8#${mode} & 8#0002) != 0 ))
}

validate_log_path() {
    local target="$1"
    local dir

    [[ "$target" = /* ]] || die "Log file path must be absolute: ${target}"
    [[ ! -L "$target" ]] || die "Refusing to write the log through a symlink: ${target}"

    dir="$(dirname "$target")"

    # A predictable log path inside a world-writable directory is a symlink-swap
    # target for any local user, and this script runs privileged steps.
    if [[ "$LOG_FILE_EXPLICIT" -ne 1 && -d "$dir" ]] && dir_is_world_writable "$dir"; then
        die "Refusing to use the default log path inside world-writable directory ${dir}. Pass --log-file to override."
    fi
}

finalize_log_file() {
    local target="$LOG_FILE"
    local dir

    if [[ "$LOG_FILE_EXPLICIT" -ne 1 ]]; then
        if [[ -n "$CONSOLE_HOME" && -d "$CONSOLE_HOME" ]]; then
            target="${CONSOLE_HOME}/Library/Logs/${APP_NAME}/${APP_NAME}.log"
        else
            target="/var/log/${APP_NAME}/${APP_NAME}.log"
        fi
    fi

    validate_log_path "$target"
    dir="$(dirname "$target")"

    # Try unprivileged first: the default lives in the console user's own home,
    # and escalating there would only leave root-owned files behind.
    if [[ ! -d "$dir" ]]; then
        if mkdir -p "$dir" 2>/dev/null; then
            chmod 0700 "$dir" 2>/dev/null || true
        else
            run_as_root mkdir -p "$dir" || die "Unable to create log directory ${dir}."
            run_as_root chmod 0700 "$dir" || warn "Unable to set permissions on log directory ${dir}."
            if [[ -n "$CONSOLE_USER" && "$target" == "${CONSOLE_HOME}/"* ]]; then
                run_as_root chown "$CONSOLE_USER:$CONSOLE_GROUP" "$dir" || warn "Unable to set ownership on log directory ${dir}."
            fi
        fi
    fi

    if ! : >"$target" 2>/dev/null; then
        run_as_root install -m 0600 /dev/null "$target" || die "Unable to create log file ${target}."
        if [[ "$target" == "${CONSOLE_HOME}/"* && -n "$CONSOLE_USER" ]]; then
            run_as_root chown "$CONSOLE_USER:$CONSOLE_GROUP" "$target" || true
        fi
    fi

    if [[ -n "$BOOTSTRAP_LOG" && -f "$BOOTSTRAP_LOG" ]]; then
        cat "$BOOTSTRAP_LOG" >>"$target" || true
        rm -f "$BOOTSTRAP_LOG" >/dev/null 2>&1 || true
        BOOTSTRAP_LOG=""
    fi

    LOG_FILE="$target"
    info "Logging to ${LOG_FILE}."
}

# -----------------------------------------------
# Configuration file
# -----------------------------------------------
trim_whitespace() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

strip_quotes() {
    local value="$1"

    if [[ "${#value}" -ge 2 ]]; then
        if [[ "${value:0:1}" == '"' && "${value: -1}" == '"' ]]; then
            printf '%s' "${value:1:${#value}-2}"
            return 0
        fi
        if [[ "${value:0:1}" == "'" && "${value: -1}" == "'" ]]; then
            printf '%s' "${value:1:${#value}-2}"
            return 0
        fi
    fi

    printf '%s' "$value"
}

parse_bool() {
    local value="$1"
    local context="$2"

    case "$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on) printf '1' ;;
        0|false|no|off) printf '0' ;;
        *) die "Invalid boolean value '${value}' for ${context}. Use true/false." ;;
    esac
}

apply_config_value() {
    local key="$1"
    local value="$2"
    local origin="$3"

    case "$key" in
        NETWORK_URL) NETWORK_URL="$value" ;;
        DESTINATION) DESTINATION="$value" ;;
        SIZE) SIZE="$value" ;;
        FILESYSTEM) FILESYSTEM="$value" ;;
        VOLUME_NAME) VOLUME_NAME="$value" ;;
        HELPER_DIR) HELPER_DIR="$value" ;;
        LABEL_PREFIX) LABEL_PREFIX="$value" ;;
        LAUNCH_INTERVAL) LAUNCH_INTERVAL="$value" ;;
        GUI_MOUNT_COOLDOWN) GUI_MOUNT_COOLDOWN="$value" ;;
        BACKUP_ALERT_DAYS) BACKUP_ALERT_DAYS="$value" ;;
        SUPPRESS_MOUNT_WINDOW) SUPPRESS_MOUNT_WINDOW="$(parse_bool "$value" "SUPPRESS_MOUNT_WINDOW in ${origin}")" ;;
        PASSWORD_ENV_VAR) PASSWORD_ENV_VAR="$value" ;;
        ENABLE_ENCRYPTION) ENABLE_ENCRYPTION="$(parse_bool "$value" "ENABLE_ENCRYPTION in ${origin}")" ;;
        START_FIRST_BACKUP) START_FIRST_BACKUP="$(parse_bool "$value" "START_FIRST_BACKUP in ${origin}")" ;;
        LOG_FILE)
            LOG_FILE="$value"
            LOG_FILE_EXPLICIT=1
            ;;
        ENCRYPTION_PASSWORD)
            die "${origin}: ENCRYPTION_PASSWORD must not be stored in a config file. Use PASSWORD_ENV_VAR or the interactive prompt."
            ;;
        *)
            die "${origin}: unsupported configuration key '${key}'."
            ;;
    esac
}

# Deliberately a hand-rolled parser rather than `source`: this file may be read
# while running under sudo, and sourcing it would make it arbitrary root code.
load_config_file() {
    local path="$1"
    local line=""
    local line_no=0
    local key=""
    local value=""
    local mode=""

    [[ -f "$path" ]] || die "Config file not found: ${path}"
    [[ -r "$path" ]] || die "Config file is not readable: ${path}"

    mode="$(stat -f '%Lp' "$path" 2>/dev/null || true)"
    if [[ -n "$mode" ]] && (( (8#${mode} & 8#0022) != 0 )); then
        warn "Config file ${path} is group- or world-writable; tighten it with chmod 600."
    fi

    while IFS= read -r line || [[ -n "$line" ]]; do
        line_no=$((line_no + 1))
        line="${line%$'\r'}"
        line="$(trim_whitespace "$line")"

        [[ -n "$line" ]] || continue
        [[ "${line:0:1}" != "#" ]] || continue

        [[ "$line" == *=* ]] || die "${path}:${line_no}: expected KEY=value, got '${line}'."

        key="$(trim_whitespace "${line%%=*}")"
        value="$(trim_whitespace "${line#*=}")"
        value="$(strip_quotes "$value")"

        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "${path}:${line_no}: invalid configuration key '${key}'."

        apply_config_value "$key" "$value" "${path}:${line_no}"
    done <"$path"

    CONFIG_FILE="$path"
    info "Loaded configuration from ${path}."
}

resolve_config_file() {
    local explicit="$1"
    local candidate=""

    if [[ -n "$explicit" ]]; then
        load_config_file "$explicit"
        return 0
    fi

    if [[ -n "${CHRONOS_GN_CONFIG:-}" ]]; then
        load_config_file "$CHRONOS_GN_CONFIG"
        return 0
    fi

    candidate="${XDG_CONFIG_HOME:-${HOME:-}/.config}/${APP_NAME}/config"
    if [[ -n "${HOME:-}" || -n "${XDG_CONFIG_HOME:-}" ]] && [[ -f "$candidate" ]]; then
        load_config_file "$candidate"
        return 0
    fi

    candidate="/etc/${APP_NAME}/config"
    if [[ -f "$candidate" ]]; then
        load_config_file "$candidate"
        return 0
    fi

    return 0
}

# Config values are applied before the flag loop so that CLI flags always win.
preload_config() {
    local explicit=""

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -c|--config)
                explicit="${2:?Missing value for $1}"
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                shift
                ;;
        esac
    done

    resolve_config_file "$explicit"
}

parse_args() {
    preload_config "$@"

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -s|--size)
                SIZE="${2:?Missing value for $1}"
                shift 2
                ;;
            -d|--destination)
                DESTINATION="${2:?Missing value for $1}"
                shift 2
                ;;
            -f|--filesystem)
                FILESYSTEM="${2:?Missing value for $1}"
                shift 2
                ;;
            -u|--url)
                NETWORK_URL="${2:?Missing value for $1}"
                shift 2
                ;;
            -n|--name)
                VOLUME_NAME="${2:?Missing value for $1}"
                shift 2
                ;;
            --no-encryption)
                ENABLE_ENCRYPTION=0
                shift
                ;;
            --password-env)
                PASSWORD_ENV_VAR="${2:?Missing value for $1}"
                shift 2
                ;;
            -c|--config)
                # Already consumed by preload_config.
                shift 2
                ;;
            --label-prefix)
                LABEL_PREFIX="${2:?Missing value for $1}"
                shift 2
                ;;
            --helper-dir)
                HELPER_DIR="${2:?Missing value for $1}"
                shift 2
                ;;
            --no-migrate)
                MIGRATE_LEGACY=0
                shift
                ;;
            --no-launchagent)
                SETUP_LAUNCHAGENT=0
                shift
                ;;
            --launchagent-only)
                LAUNCHAGENT_ONLY=1
                START_FIRST_BACKUP=0
                shift
                ;;
            --launch-interval)
                LAUNCH_INTERVAL="${2:?Missing value for $1}"
                shift 2
                ;;
            --gui-mount-cooldown)
                GUI_MOUNT_COOLDOWN="${2:?Missing value for $1}"
                shift 2
                ;;
            --backup-alert-days)
                BACKUP_ALERT_DAYS="${2:?Missing value for $1}"
                shift 2
                ;;
            --keep-mount-window)
                SUPPRESS_MOUNT_WINDOW=0
                shift
                ;;
            --no-start-backup)
                START_FIRST_BACKUP=0
                shift
                ;;
            --force-clean-partial)
                FORCE_CLEAN_PARTIAL=1
                shift
                ;;
            -y|--yes)
                ASSUME_YES=1
                shift
                ;;
            -v|--verbose)
                VERBOSE=1
                shift
                ;;
            --debug)
                DEBUG=1
                VERBOSE=1
                shift
                ;;
            --log-file)
                LOG_FILE="${2:?Missing value for $1}"
                LOG_FILE_EXPLICIT=1
                shift 2
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done
}
# -----------------------------------------------
# Validation
# -----------------------------------------------
require_command() {
    local command_name="$1"
    command -v "$command_name" >/dev/null 2>&1 || die "Required command not found: ${command_name}"
}

validate_size() {
    [[ "$SIZE" =~ ^[1-9][0-9]*[bBkKmMgGtTpPeE]$ ]] || die "Invalid size '${SIZE}'. Use values like 500g or 2t."
    SIZE="$(printf '%s' "$SIZE" | tr '[:upper:]' '[:lower:]')"
}

validate_filesystem() {
    case "$FILESYSTEM" in
        "APFS"|"Case-sensitive APFS"|"Journaled HFS+"|"Case-sensitive Journaled HFS+")
            ;;
        *)
            die "Unsupported filesystem '${FILESYSTEM}'."
            ;;
    esac
}

validate_destination() {
    [[ "$DESTINATION" = /* ]] || die "Destination must be an absolute path."
    [[ "$DESTINATION" != "/" ]] || die "Destination '/' is not allowed."
    [[ "$DESTINATION" != "/Volumes" ]] || die "Destination '/Volumes' is too broad and is not allowed."
}

validate_launch_interval() {
    [[ "$LAUNCH_INTERVAL" =~ ^[1-9][0-9]*$ ]] || die "Launch interval must be a positive integer."
}

validate_gui_mount_cooldown() {
    [[ "$GUI_MOUNT_COOLDOWN" =~ ^[0-9]+$ ]] || die "GUI mount cooldown must be a non-negative integer."
}

validate_backup_alert_days() {
    [[ "$BACKUP_ALERT_DAYS" =~ ^[0-9]+$ ]] || die "Backup alert days must be a non-negative integer."
}

validate_label_prefix() {
    [[ "$LABEL_PREFIX" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Invalid label prefix '${LABEL_PREFIX}'. Use reverse-DNS form, e.g. io.github.yourname."
    [[ "$LABEL_PREFIX" != *".." ]] || die "Invalid label prefix '${LABEL_PREFIX}'."
}

validate_helper_dir() {
    [[ "$HELPER_DIR" = /* ]] || die "Helper directory must be an absolute path."
    case "$HELPER_DIR" in
        "/"|"/usr"|"/usr/local"|"/usr/local/lib"|"/etc"|"/var"|"/tmp")
            die "Helper directory '${HELPER_DIR}' is too broad and is not allowed."
            ;;
    esac
}

validate_url() {
    if [[ -z "$NETWORK_URL" ]]; then
        die "A network share URL is required. Set it with --url smb://host/share, with NETWORK_URL in a config file, or via CHRONOS_GN_CONFIG."
    fi

    [[ "$NETWORK_URL" =~ ^(smb|afp)://[^/]+/.+ ]] || die "Network URL must look like smb://host/share or afp://host/share."

    SHARE_HOST="$(printf '%s' "$NETWORK_URL" | sed -E 's#^[a-z]+://([^/@]+@)?([^/]+)/.*#\2#')"
    [[ -n "$SHARE_HOST" ]] || die "Unable to determine share host from URL '${NETWORK_URL}'."

    case "$NETWORK_URL" in
        smb://*) SHARE_PORT=445 ;;
        afp://*) SHARE_PORT=548 ;;
        *) die "Unsupported network URL scheme in '${NETWORK_URL}'." ;;
    esac
}
# -----------------------------------------------
# Gather Data
# -----------------------------------------------
prepare_context() {
    CONSOLE_USER="$(stat -f '%Su' /dev/console)"
    [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" ]] || die "Unable to determine the logged-in console user."

    CONSOLE_UID="$(id -u "$CONSOLE_USER")"
    CONSOLE_GROUP="$(id -gn "$CONSOLE_USER")"
    CONSOLE_HOME="$(dscl . -read "/Users/${CONSOLE_USER}" NFSHomeDirectory | awk '{print $2}')"
    [[ -n "$CONSOLE_HOME" ]] || die "Unable to determine home directory for ${CONSOLE_USER}."

    COMPUTER_NAME="$(scutil --get ComputerName)"
    HARDWARE_UUID="$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F '"' '/IOPlatformUUID/ { print $4; exit }')"
    [[ -n "$HARDWARE_UUID" ]] || die "Unable to determine hardware UUID."

    PRIMARY_MAC="$(ifconfig en0 2>/dev/null | awk '/ether/ { print $2; exit }' || true)"
    if [[ -z "$PRIMARY_MAC" ]]; then
        PRIMARY_MAC="$(ifconfig en1 2>/dev/null | awk '/ether/ { print $2; exit }' || true)"
    fi
    [[ -n "$PRIMARY_MAC" ]] || die "Unable to determine a primary MAC address from en0 or en1."
    PRIMARY_MAC="$(printf '%s' "$PRIMARY_MAC" | tr -d ':' | tr '[:lower:]' '[:upper:]')"

    BUNDLE_NAME="${COMPUTER_NAME}_${PRIMARY_MAC}.sparsebundle"
    BUNDLE_PATH="${DESTINATION}/${BUNDLE_NAME}"
    MACHINE_ID_PLIST="${BUNDLE_PATH}/com.apple.TimeMachine.MachineID.plist"
    STAGING_BUNDLE="${DESTINATION}/.${BUNDLE_NAME}.partial"
    LAUNCH_AGENT_LABEL="${LABEL_PREFIX}.${APP_NAME}"
    LAUNCH_AGENT_PATH="${CONSOLE_HOME}/Library/LaunchAgents/${LAUNCH_AGENT_LABEL}.plist"
    HELPER_SCRIPT_PATH="${HELPER_DIR}/${APP_NAME}-remount.sh"
    MONITOR_SCRIPT_PATH="${HELPER_DIR}/${APP_NAME}-remount-monitor.sh"
    LAUNCH_LOG_DIR="${CONSOLE_HOME}/Library/Logs/${APP_NAME}"
    EXPECTED_IMAGE_MOUNT_POINT="/Volumes/${VOLUME_NAME}"

    LEGACY_LAUNCH_AGENT_LABEL="com.${CONSOLE_USER}.chronos"
    LEGACY_LAUNCH_AGENT_PATH="${CONSOLE_HOME}/Library/LaunchAgents/${LEGACY_LAUNCH_AGENT_LABEL}.plist"
    LEGACY_LAUNCH_LOG_DIR="${CONSOLE_HOME}/Library/Logs/Chronos"

    TMP_DIR="$(mktemp -d "/tmp/${APP_NAME}.XXXXXX")"
    TMP_BUNDLE="${TMP_DIR}/${BUNDLE_NAME}"
}

validate_setup() {
    require_command awk
    require_command cp
    require_command date
    require_command diskutil
    require_command dscl
    require_command find
    require_command hdiutil
    require_command ioreg
    require_command launchctl
    require_command mv
    require_command nc
    require_command open
    require_command osascript
    require_command plutil
    require_command scutil
    require_command stat
    require_command tmutil
    require_command /usr/libexec/PlistBuddy

    validate_size
    validate_filesystem
    validate_destination
    validate_url
    validate_launch_interval
    validate_gui_mount_cooldown
    validate_backup_alert_days
    validate_label_prefix
    validate_helper_dir

    if [[ "$LAUNCHAGENT_ONLY" -eq 1 && "$SETUP_LAUNCHAGENT" -ne 1 ]]; then
        die "--launchagent-only cannot be combined with --no-launchagent."
    fi

    if [[ "$LOG_FILE_EXPLICIT" -eq 1 ]]; then
        validate_log_path "$LOG_FILE"
    fi
}
# -----------------------------------------------
# Network Mount
# -----------------------------------------------
warn_if_host_unreachable() {
    if ! nc -z -w 2 "$SHARE_HOST" "$SHARE_PORT" >/dev/null 2>&1; then
        warn "Unable to reach ${SHARE_HOST}:${SHARE_PORT} before mounting. The share may still prompt and mount if it becomes available."
    fi
}

mount_network_share_once() {
    if is_mountpoint "$DESTINATION"; then
        if path_is_accessible "$DESTINATION"; then
            info "Network share already mounted and reachable at ${DESTINATION}."
            return 0
        fi

        warn "Network share mountpoint ${DESTINATION} exists but is not reachable; requesting reconnect."
    fi

    info "Requesting mount for ${NETWORK_URL}."
    run_in_console_user_context open "$NETWORK_URL" >/dev/null 2>&1 || return 1
    wait_for_mountpoint "$DESTINATION" 30 || return 1
    path_is_accessible "$DESTINATION"
}

mount_network_share() {
    warn_if_host_unreachable
    retry 3 5 mount_network_share_once || die "Failed to mount network share ${NETWORK_URL} at ${DESTINATION}."
    info "Network share mounted at ${DESTINATION}."
}

# Accepts the pre-3.0 variable name so existing automation keeps working.
password_from_env() {
    local value="${!PASSWORD_ENV_VAR:-}"

    if [[ -z "$value" && "$PASSWORD_ENV_VAR" != "$LEGACY_PASSWORD_ENV_VAR" ]]; then
        value="${!LEGACY_PASSWORD_ENV_VAR:-}"
        if [[ -n "$value" && "$LEGACY_PASSWORD_WARNED" -eq 0 ]]; then
            LEGACY_PASSWORD_WARNED=1
            warn "Using deprecated ${LEGACY_PASSWORD_ENV_VAR}; rename it to ${PASSWORD_ENV_VAR}."
        fi
    fi

    printf '%s' "$value"
}

get_encryption_password() {
    local password="${ENCRYPTION_PASSWORD:-$(password_from_env)}"

    if [[ -n "$password" ]]; then
        ENCRYPTION_PASSWORD="$password"
        printf '%s' "$password"
        return 0
    fi

    [[ -t 0 ]] || die "Encryption is enabled but ${PASSWORD_ENV_VAR} is not set and no TTY is available for prompting."

    local first=""
    local second=""
    while true; do
        read -r -s -p "Enter encryption password: " first
        printf '\n'
        read -r -s -p "Confirm encryption password: " second
        printf '\n'

        [[ -n "$first" ]] || { warn "Password cannot be empty."; continue; }
        [[ "$first" == "$second" ]] || { warn "Passwords do not match."; continue; }

        ENCRYPTION_PASSWORD="$first"
        printf '%s' "$first"
        return 0
    done
}

validate_local_sparsebundle_image() {
    local image_path="$1"

    if [[ "$ENABLE_ENCRYPTION" -eq 1 ]]; then
        local validation_password="${ENCRYPTION_PASSWORD:-$(password_from_env)}"

        if [[ -n "$validation_password" ]]; then
            printf '%s' "$validation_password" | hdiutil imageinfo -stdinpass "$image_path" >/dev/null 2>&1
        else
            hdiutil imageinfo "$image_path" >/dev/null 2>&1
        fi
    else
        hdiutil imageinfo "$image_path" >/dev/null 2>&1
    fi
}

# Runs `ls` on $1 in the background and kills it if it has not returned within
# $2 seconds, so a dead SMB mount that still answers `mount`/`stat` metadata but
# blocks on real I/O cannot hang the installer.
probe_path_with_timeout() {
    local path="$1"
    local timeout="$2"
    local pid
    local elapsed=0

    # -la (not -ld): a readdir plus per-entry getattr forces real I/O, where a
    # bare stat of the vnode can still be answered from cache on a dead volume.
    /bin/ls -la "$path" >/dev/null 2>&1 &
    pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        if [[ "$elapsed" -ge "$timeout" ]]; then
            kill -KILL "$pid" >/dev/null 2>&1 || true
            wait "$pid" >/dev/null 2>&1 || true
            return 1
        fi
        sleep 1 || true
        elapsed=$((elapsed + 1))
    done

    wait "$pid"
}

path_is_accessible() {
    local target="$1"

    [[ -e "$target" ]] || return 1
    probe_path_with_timeout "$target" 10
}

validate_sparsebundle_structure() {
    local image_path="$1"

    [[ -d "$image_path" ]] || return 1

    if [[ ! -f "${image_path}/Info.plist" ]]; then
        warn "Sparsebundle at ${image_path} is missing Info.plist."
        return 1
    fi

    if [[ ! -d "${image_path}/bands" ]]; then
        warn "Sparsebundle at ${image_path} is missing bands/."
        return 1
    fi

    # token is only present for encrypted bundles, so its absence is tolerated.
    return 0
}

handle_partial_state() {
    if [[ -d "$STAGING_BUNDLE" ]]; then
        warn "Found partial sparsebundle state at ${STAGING_BUNDLE}."
        if [[ "$FORCE_CLEAN_PARTIAL" -eq 1 ]] || confirm_action "Delete partial sparsebundle ${STAGING_BUNDLE}?"; then
            rm -rf "$STAGING_BUNDLE" || run_as_root rm -rf "$STAGING_BUNDLE"
            info "Removed partial sparsebundle ${STAGING_BUNDLE}."
        else
            die "Partial sparsebundle exists at ${STAGING_BUNDLE}; aborting to avoid unsafe overwrite."
        fi
    fi
}

# Compares the local, known-good $TMP_BUNDLE against the share copy at
# $STAGING_BUNDLE so a copy truncated by a dropped SMB connection is never
# silently promoted to $BUNDLE_PATH. Every check must pass; the first mismatch
# is logged with both values and the function returns 1.
verify_bundle_copy() {
    local local_files="" staging_files=""
    local_files="$(find "$TMP_BUNDLE" -type f | wc -l | tr -d ' [:space:]')"
    staging_files="$(find "$STAGING_BUNDLE" -type f | wc -l | tr -d ' [:space:]')"
    if [[ "$local_files" != "$staging_files" ]]; then
        warn "Bundle copy verification failed: file count mismatch (local=${local_files}, staging=${staging_files})."
        return 1
    fi

    local local_bands=0 staging_bands=0
    if [[ -d "${TMP_BUNDLE}/bands" ]]; then
        local_bands="$(find "${TMP_BUNDLE}/bands" -type f | wc -l | tr -d ' [:space:]')"
    fi
    if [[ -d "${STAGING_BUNDLE}/bands" ]]; then
        staging_bands="$(find "${STAGING_BUNDLE}/bands" -type f | wc -l | tr -d ' [:space:]')"
    fi
    if [[ "$local_bands" != "$staging_bands" ]]; then
        warn "Bundle copy verification failed: band file count mismatch (local=${local_bands}, staging=${staging_bands})."
        return 1
    fi

    if ! cmp -s "${TMP_BUNDLE}/Info.plist" "${STAGING_BUNDLE}/Info.plist"; then
        warn "Bundle copy verification failed: Info.plist differs between ${TMP_BUNDLE} and ${STAGING_BUNDLE}."
        return 1
    fi

    local local_bytes="" staging_bytes=""
    local_bytes="$(find "$TMP_BUNDLE" -type f -exec stat -f %z {} + | awk '{ s += $1 } END { print s+0 }')"
    staging_bytes="$(find "$STAGING_BUNDLE" -type f -exec stat -f %z {} + | awk '{ s += $1 } END { print s+0 }')"
    if [[ "$local_bytes" != "$staging_bytes" ]]; then
        warn "Bundle copy verification failed: total byte size mismatch (local=${local_bytes}, staging=${staging_bytes})."
        return 1
    fi

    return 0
}

copy_bundle_to_share() {
    handle_partial_state

    info "Copying sparsebundle to staging path ${STAGING_BUNDLE}."
    if ! cp -R -X "$TMP_BUNDLE" "$STAGING_BUNDLE"; then
        warn "cp returned non-zero status while copying to SMB share; removing the partial copy and retrying once."
        rm -rf "$STAGING_BUNDLE" || true
        if ! cp -R -X "$TMP_BUNDLE" "$STAGING_BUNDLE"; then
            die "Failed to copy sparsebundle to ${STAGING_BUNDLE} after a retry; the share connection likely dropped mid-copy and the partial copy was removed."
        fi
    fi

    verify_bundle_copy || die "Sparsebundle staging copy at ${STAGING_BUNDLE} does not match the local original; refusing to promote a possibly truncated copy."

    info "Promoting staged sparsebundle to ${BUNDLE_PATH}."
    if ! mv "$STAGING_BUNDLE" "$BUNDLE_PATH"; then
        warn "mv returned non-zero status while promoting the sparsebundle; checking whether the final bundle exists anyway."
    fi

    if [[ ! -d "$BUNDLE_PATH" && -d "$STAGING_BUNDLE" ]]; then
        warn "Final bundle path is missing after promote; retrying direct move once."
        mv "$STAGING_BUNDLE" "$BUNDLE_PATH" || true
    fi

    [[ -d "$BUNDLE_PATH" ]] || die "Sparsebundle copy failed and ${BUNDLE_PATH} is missing."
    validate_sparsebundle_structure "$BUNDLE_PATH" || die "Sparsebundle exists at ${BUNDLE_PATH} but does not look usable."

    probe_path_with_timeout "${BUNDLE_PATH}/Info.plist" 15 || die "Sparsebundle at ${BUNDLE_PATH} is not readable after promotion; the share connection may have dropped."

    if [[ -d "$STAGING_BUNDLE" ]]; then
        warn "Removing leftover staging bundle ${STAGING_BUNDLE}."
        rm -rf "$STAGING_BUNDLE" || warn "Unable to remove leftover staging bundle ${STAGING_BUNDLE}."
    fi
}
# -----------------------------------------------
# Sparsebundle Creation
# -----------------------------------------------
create_sparsebundle() {
    if [[ -d "$BUNDLE_PATH" ]]; then
        validate_sparsebundle_structure "$BUNDLE_PATH" || die "Existing sparsebundle at ${BUNDLE_PATH} does not look usable."
        info "Sparsebundle already exists at ${BUNDLE_PATH}; deferring final validation to the mount step."
        SUMMARY_BUNDLE_STATUS="reused-existing"
        return 0
    fi

    info "Creating sparsebundle ${TMP_BUNDLE} (${SIZE}, ${FILESYSTEM})."

    local create_output=""
    if [[ "$ENABLE_ENCRYPTION" -eq 1 ]]; then
        local encryption_password
        encryption_password="$(get_encryption_password)"
        if ! create_output="$(printf '%s' "$encryption_password" | hdiutil create \
            -size "$SIZE" \
            -fs "$FILESYSTEM" \
            -type SPARSEBUNDLE \
            -volname "$VOLUME_NAME" \
            -encryption AES-256 \
            -stdinpass \
            "$TMP_BUNDLE" \
            2>&1)"; then
            unset encryption_password
            die "hdiutil create failed for ${TMP_BUNDLE}: ${create_output}"
        fi
        unset encryption_password
    else
        if ! create_output="$(hdiutil create \
            -size "$SIZE" \
            -fs "$FILESYSTEM" \
            -type SPARSEBUNDLE \
            -volname "$VOLUME_NAME" \
            "$TMP_BUNDLE" \
            2>&1)"; then
            die "hdiutil create failed for ${TMP_BUNDLE}: ${create_output}"
        fi
    fi

    [[ -d "$TMP_BUNDLE" ]] || die "Sparsebundle creation reported success but ${TMP_BUNDLE} was not created."
    validate_local_sparsebundle_image "$TMP_BUNDLE" || die "New sparsebundle ${TMP_BUNDLE} is invalid."

    copy_bundle_to_share

    rm -rf "$TMP_BUNDLE"
    SUMMARY_BUNDLE_STATUS="created-new"
}

write_machine_id_plist() {
    info "Writing MachineID metadata to ${MACHINE_ID_PLIST}."

    [[ -d "$BUNDLE_PATH" ]] || die "Sparsebundle path does not exist: ${BUNDLE_PATH}"
    local temp_plist="${TMP_DIR}/com.apple.TimeMachine.MachineID.plist"

    cat >"$temp_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>HardwareUUID</key>
    <string>${HARDWARE_UUID}</string>
    <key>MachineName</key>
    <string>${COMPUTER_NAME}</string>
</dict>
</plist>
EOF

    if ! cp -X "$temp_plist" "$MACHINE_ID_PLIST"; then
        warn "MachineID plist copy returned non-zero status; checking whether the destination file exists anyway."
    fi
    [[ -f "$MACHINE_ID_PLIST" ]] || die "Failed to write MachineID plist to ${MACHINE_ID_PLIST}."
    chmod 0644 "$MACHINE_ID_PLIST" || warn "Unable to set permissions on ${MACHINE_ID_PLIST}; some SMB servers do not support mode changes and this is harmless."
}

get_existing_mount_for_image() {
    local info_plist_file=""
    local image_index=0
    local entity_index=0
    local current_path=""
    local mount_point=""
    local dev_entry=""
    local disk_info_file=""

    info_plist_file="$(mktemp "${TMP_DIR}/hdiutil-info.XXXXXX.plist")" || return 1
    hdiutil info -plist >"$info_plist_file" 2>/dev/null || return 1
    plutil -lint "$info_plist_file" >/dev/null 2>&1 || return 1

    while true; do
        current_path="$(/usr/libexec/PlistBuddy -c "Print :images:${image_index}:image-path" "$info_plist_file" 2>/dev/null || true)"
        [[ -n "$current_path" ]] || break

        if [[ "$current_path" == "$BUNDLE_PATH" ]]; then
            entity_index=0
            while true; do
                mount_point="$(/usr/libexec/PlistBuddy -c "Print :images:${image_index}:system-entities:${entity_index}:mount-point" "$info_plist_file" 2>/dev/null || true)"
                if [[ -n "$mount_point" ]]; then
                    printf '%s\n' "$mount_point"
                    return 0
                fi

                dev_entry="$(/usr/libexec/PlistBuddy -c "Print :images:${image_index}:system-entities:${entity_index}:dev-entry" "$info_plist_file" 2>/dev/null || true)"
                [[ -n "$dev_entry" ]] || break

                disk_info_file="${TMP_DIR}/diskutil-info-${image_index}-${entity_index}.plist"
                if diskutil info -plist "$dev_entry" >"$disk_info_file" 2>/dev/null && plutil -lint "$disk_info_file" >/dev/null 2>&1; then
                    mount_point="$(/usr/libexec/PlistBuddy -c "Print :MountPoint" "$disk_info_file" 2>/dev/null || true)"
                    if [[ -n "$mount_point" ]]; then
                        printf '%s\n' "$mount_point"
                        return 0
                    fi
                fi

                entity_index=$((entity_index + 1))
            done

            break
        fi

        image_index=$((image_index + 1))
    done

    return 1
}

device_for_mount_point() {
    local mount_point="$1"
    diskutil info "$mount_point" 2>/dev/null | awk -F': *' '/Device Node/ { print $2; exit }'
}

detach_image_mount() {
    local mount_point="$1"
    local device

    device="$(device_for_mount_point "$mount_point" || true)"
    if [[ -n "$device" ]]; then
        hdiutil detach "$device" -quiet >/dev/null 2>&1 && return 0
        hdiutil detach "$device" -force -quiet >/dev/null 2>&1
    else
        hdiutil detach "$mount_point" -quiet >/dev/null 2>&1 && return 0
        hdiutil detach "$mount_point" -force -quiet >/dev/null 2>&1
    fi
}

mount_sparsebundle_once() {
    if is_mountpoint "$EXPECTED_IMAGE_MOUNT_POINT"; then
        if probe_path_with_timeout "$EXPECTED_IMAGE_MOUNT_POINT" 10; then
            IMAGE_MOUNT_POINT="$EXPECTED_IMAGE_MOUNT_POINT"
            IMAGE_DEVICE="$(device_for_mount_point "$IMAGE_MOUNT_POINT" || true)"
            info "Sparsebundle already mounted at ${IMAGE_MOUNT_POINT}."
            return 0
        fi
        warn "Mounted volume at ${EXPECTED_IMAGE_MOUNT_POINT} is stale and not answering reads; detaching before remount."
        detach_image_mount "$EXPECTED_IMAGE_MOUNT_POINT" || true
    fi

    local existing_mount
    existing_mount="$(get_existing_mount_for_image || true)"
    if [[ -n "$existing_mount" ]]; then
        if probe_path_with_timeout "$existing_mount" 10; then
            IMAGE_MOUNT_POINT="$existing_mount"
            IMAGE_DEVICE="$(device_for_mount_point "$IMAGE_MOUNT_POINT" || true)"
            if [[ "$existing_mount" != "$EXPECTED_IMAGE_MOUNT_POINT" ]]; then
                warn "Sparsebundle is already mounted at ${existing_mount} instead of ${EXPECTED_IMAGE_MOUNT_POINT}."
            else
                info "Sparsebundle already mounted at ${IMAGE_MOUNT_POINT}."
            fi
            return 0
        fi
        warn "Mounted volume at ${existing_mount} is stale and not answering reads; detaching before remount."
        detach_image_mount "$existing_mount" || true
    fi

    if pgrep -x DiskImageMounter >/dev/null 2>&1; then
        warn "A disk-image password dialog is already open; waiting for it instead of requesting another mount."
        if wait_for_mountpoint "$EXPECTED_IMAGE_MOUNT_POINT" 45; then
            IMAGE_MOUNT_POINT="$EXPECTED_IMAGE_MOUNT_POINT"
            IMAGE_DEVICE="$(device_for_mount_point "$IMAGE_MOUNT_POINT" || true)"
            return 0
        fi
        return 1
    fi

    # Prefer Finder/open here because it has proven more compatible with Time Machine
    # sparsebundles on SMB than a fully hdiutil-driven attach flow.
    info "Requesting sparsebundle mount using macOS-native open for ${BUNDLE_PATH}."
    run_in_console_user_context open "$BUNDLE_PATH" >/dev/null 2>&1 || return 1

    if wait_for_mountpoint "$EXPECTED_IMAGE_MOUNT_POINT" 45; then
        IMAGE_MOUNT_POINT="$EXPECTED_IMAGE_MOUNT_POINT"
    else
        existing_mount="$(get_existing_mount_for_image || true)"
        [[ -n "$existing_mount" ]] || return 1
        IMAGE_MOUNT_POINT="$existing_mount"
        if [[ "$existing_mount" != "$EXPECTED_IMAGE_MOUNT_POINT" ]]; then
            warn "Sparsebundle mounted at ${existing_mount}; expected ${EXPECTED_IMAGE_MOUNT_POINT}."
        fi
    fi

    IMAGE_DEVICE="$(device_for_mount_point "$IMAGE_MOUNT_POINT" || true)"
    MOUNTED_IMAGE_IN_RUN=1
    return 0
}
# -----------------------------------------------
# Mount
# -----------------------------------------------
mount_image() {
    info "Preparing to mount sparsebundle ${BUNDLE_PATH}."
    [[ -d "$BUNDLE_PATH" ]] || die "Sparsebundle path does not exist: ${BUNDLE_PATH}"

    retry 3 5 mount_sparsebundle_once || die "Failed to mount sparsebundle ${BUNDLE_PATH}. If it is encrypted, confirm the password prompt succeeded or that the password is stored in Keychain."
    [[ -d "$IMAGE_MOUNT_POINT" ]] || die "Sparsebundle mounted but mount point ${IMAGE_MOUNT_POINT} is missing."
    info "Sparsebundle mounted at ${IMAGE_MOUNT_POINT}."
}

tm_destination_info() {
    tmutil destinationinfo 2>/dev/null || true
}

tm_destination_matches_path() {
    local destination_info
    destination_info="$(tm_destination_info)"
    [[ -n "$destination_info" ]] || return 1
    printf '%s\n' "$destination_info" | awk -v t="$IMAGE_MOUNT_POINT" '
        /^Mount Point[[:space:]]*:/ {
            line = $0
            sub(/^Mount Point[[:space:]]*:[[:space:]]*/, "", line)
            if (line == t) found = 1
        }
        END { exit found ? 0 : 1 }
    '
}

tm_destination_matches_name() {
    local destination_info
    destination_info="$(tm_destination_info)"
    [[ -n "$destination_info" ]] || return 1
    printf '%s\n' "$destination_info" | awk -v t="$VOLUME_NAME" '
        /^Name[[:space:]]*:/ {
            line = $0
            sub(/^Name[[:space:]]*:[[:space:]]*/, "", line)
            if (line == t) found = 1
        }
        END { exit found ? 0 : 1 }
    '
}
# -----------------------------------------------
# Configuration
# -----------------------------------------------
configure_tm() {
    info "Configuring Time Machine destination with tmutil."

    if tm_destination_matches_path; then
        info "Time Machine destination already configured for ${IMAGE_MOUNT_POINT}; keeping configuration idempotent."
        return 0
    fi

    if tm_destination_matches_name; then
        warn "A Time Machine destination named ${VOLUME_NAME} is already registered, but not for ${IMAGE_MOUNT_POINT}; adding the current mounted volume path."
    fi

    local output=""
    if ! output="$(run_as_root tmutil setdestination -a "$IMAGE_MOUNT_POINT" 2>&1)"; then
        die "tmutil setdestination failed for ${IMAGE_MOUNT_POINT}: ${output}"
    fi
    tm_destination_matches_path || die "Time Machine does not report ${IMAGE_MOUNT_POINT} as a destination after configuration."
}

# Encrypted bundles need the disk-image password saved in the console user's
# login keychain, or an unattended remount after a network drop will stall
# forever at a GUI password prompt nobody is there to answer. This only warns
# it never fails the run, since the password may simply not have been saved
# to Keychain yet on a brand-new bundle.
# macOS opens a Finder window for the backup volume every time it mounts, which
# interrupts whatever the user happens to be doing. The switch for that lives in
# a preference domain chronos-gn does not own, so record what was there first and
# leave the uninstaller enough to put it back exactly as it was.
readonly MOUNT_WINDOW_PREF_DOMAIN="com.apple.frameworks.diskimages"

apply_mount_window_pref() {
    local key=""
    local previous=""
    local state=""
    local state_file="${HELPER_DIR}/${APP_NAME}-mount-window.state"

    if [[ "$SUPPRESS_MOUNT_WINDOW" -ne 1 ]]; then
        SUMMARY_MOUNT_WINDOW_STATUS="left-alone"
        info "Leaving ${MOUNT_WINDOW_PREF_DOMAIN} auto-open preferences untouched (--keep-mount-window)."
        return 0
    fi

    for key in auto-open-rw-root auto-open-ro-root; do
        previous="$(run_in_console_user_context defaults read "$MOUNT_WINDOW_PREF_DOMAIN" "$key" 2>/dev/null || true)"
        [[ -n "$previous" ]] || previous="unset"

        if [[ "$previous" == "0" ]]; then
            info "${MOUNT_WINDOW_PREF_DOMAIN} ${key} is already 0; leaving it alone."
            continue
        fi

        info "${MOUNT_WINDOW_PREF_DOMAIN} ${key} was '${previous}'; setting it to 0 so mounting does not raise a Finder window."
        if ! run_in_console_user_context defaults write "$MOUNT_WINDOW_PREF_DOMAIN" "$key" -bool false >/dev/null 2>&1; then
            warn "Unable to set ${MOUNT_WINDOW_PREF_DOMAIN} ${key}; a Finder window may still open on mount."
            SUMMARY_MOUNT_WINDOW_STATUS="failed"
            return 0
        fi

        state="${state}${key} ${previous}
"
    done

    if [[ -z "$state" ]]; then
        SUMMARY_MOUNT_WINDOW_STATUS="already-suppressed"
        return 0
    fi

    # Only the keys this run actually changed are recorded, so the uninstaller
    # never reverts a value the user set themselves.
    if [[ ! -d "$HELPER_DIR" ]]; then
        run_as_root mkdir -p "$HELPER_DIR" || { warn "Unable to create ${HELPER_DIR}; not recording previous mount-window preferences."; SUMMARY_MOUNT_WINDOW_STATUS="suppressed-unrecorded"; return 0; }
        run_as_root chmod 0755 "$HELPER_DIR" || true
    fi

    if printf '%s' "$state" | write_file_atomically "$state_file" 0644; then
        SUMMARY_MOUNT_WINDOW_STATUS="suppressed"
    else
        warn "Set the mount-window preferences but could not record the previous values at ${state_file}."
        SUMMARY_MOUNT_WINDOW_STATUS="suppressed-unrecorded"
    fi
}

warn_if_keychain_entry_missing() {
    if [[ "$ENABLE_ENCRYPTION" -ne 1 ]]; then
        return 0
    fi

    if run_in_console_user_context security find-generic-password -D "disk image password" -l "$BUNDLE_NAME" >/dev/null 2>&1 \
        || run_in_console_user_context security find-generic-password -D "disk image password" -l "${BUNDLE_NAME%.sparsebundle}" >/dev/null 2>&1; then
        SUMMARY_KEYCHAIN_STATUS="found"
        info "Found a saved disk image password in the login keychain for ${BUNDLE_NAME}."
        return 0
    fi

    SUMMARY_KEYCHAIN_STATUS="missing"
    warn "No saved disk-image password was found in the login keychain for ${BUNDLE_NAME}."
    warn "Unattended remounts after a network drop WILL stall at a password prompt until someone mounts the sparsebundle manually and saves the password."
    warn "To fix this: eject the mounted volume, reopen ${BUNDLE_NAME} in Finder, enter the encryption password, and tick 'Remember password in my keychain' before clicking OK."
}

write_file_atomically() {
    local target="$1"
    local mode="$2"
    local temp_file
    temp_file="${TMP_DIR}/$(basename "$target").tmp"

    cat >"$temp_file"
    run_as_root install -m "$mode" "$temp_file" "$target"
}
# -----------------------------------------------
# Legacy 'chronos' migration
# -----------------------------------------------
legacy_install_present() {
    [[ -f "$LEGACY_LAUNCH_AGENT_PATH" || -d "$LEGACY_HELPER_DIR" || -d "$LEGACY_LAUNCH_LOG_DIR" ]]
}

# Deliberately touches only the LaunchAgent, helper assets, and logs. The
# sparsebundle and the Time Machine destination are left exactly as they are:
# configure_tm() re-registers the same mounted volume, so backup history carries
# over untouched.
# Detection and consent happen early so the user is not asked halfway through a
# long sparsebundle creation; the removal itself runs later, once the new install
# is known to be working.
check_legacy_install() {
    if ! legacy_install_present; then
        return 0
    fi

    if [[ "$MIGRATE_LEGACY" -ne 1 ]]; then
        SUMMARY_MIGRATION_STATUS="skipped-by-flag"
        warn "A legacy 'chronos' install was detected but --no-migrate was set; both remount monitors may run at once."
        return 0
    fi

    local found=()
    [[ ! -f "$LEGACY_LAUNCH_AGENT_PATH" ]] || found+=("LaunchAgent ${LEGACY_LAUNCH_AGENT_PATH}")
    [[ ! -d "$LEGACY_HELPER_DIR" ]] || found+=("helper directory ${LEGACY_HELPER_DIR}")
    [[ ! -d "$LEGACY_LAUNCH_LOG_DIR" ]] || found+=("log directory ${LEGACY_LAUNCH_LOG_DIR}")

    warn "Detected a legacy 'chronos' install:"
    local item
    for item in "${found[@]}"; do
        warn "  - ${item}"
    done
    warn "Leaving it in place would run two remount monitors against the same sparsebundle."

    if ! confirm_action "Remove the legacy chronos LaunchAgent and helper assets? (the sparsebundle and Time Machine destination are not touched)"; then
        SUMMARY_MIGRATION_STATUS="declined"
        die "Legacy chronos install left in place. Re-run with --yes to migrate, or --no-migrate to proceed without migrating."
    fi

    MIGRATION_APPROVED=1
    info "Legacy chronos migration approved; it will run once the new install is ready."
}

migrate_legacy_install() {
    if [[ "$MIGRATION_APPROVED" -ne 1 ]]; then
        return 0
    fi

    if ! legacy_install_present; then
        SUMMARY_MIGRATION_STATUS="not-needed"
        return 0
    fi

    if [[ -f "$LEGACY_LAUNCH_AGENT_PATH" ]]; then
        if run_as_root launchctl bootout "gui/${CONSOLE_UID}" "$LEGACY_LAUNCH_AGENT_PATH" >/dev/null 2>&1; then
            info "Booted out legacy LaunchAgent ${LEGACY_LAUNCH_AGENT_LABEL}."
        else
            info "Legacy LaunchAgent ${LEGACY_LAUNCH_AGENT_LABEL} was not loaded."
        fi

        run_as_root rm -f "$LEGACY_LAUNCH_AGENT_PATH" || warn "Unable to remove ${LEGACY_LAUNCH_AGENT_PATH}."
        info "Removed legacy LaunchAgent plist."
    fi

    if [[ -d "$LEGACY_HELPER_DIR" && "$LEGACY_HELPER_DIR" != "$HELPER_DIR" ]]; then
        run_as_root rm -rf "$LEGACY_HELPER_DIR" || warn "Unable to remove ${LEGACY_HELPER_DIR}."
        info "Removed legacy helper directory ${LEGACY_HELPER_DIR}."
    fi

    # Old logs are archived rather than deleted; they are the only record of how
    # the previous install was behaving.
    if [[ -d "$LEGACY_LAUNCH_LOG_DIR" && "$LEGACY_LAUNCH_LOG_DIR" != "$LAUNCH_LOG_DIR" ]]; then
        local archive_dir="${LAUNCH_LOG_DIR}/legacy-chronos"
        run_as_root mkdir -p "$LAUNCH_LOG_DIR"
        if run_as_root mv "$LEGACY_LAUNCH_LOG_DIR" "$archive_dir"; then
            run_as_root chown -R "$CONSOLE_USER:$CONSOLE_GROUP" "$archive_dir" || true
            info "Archived legacy logs to ${archive_dir}."
        else
            warn "Unable to archive legacy logs from ${LEGACY_LAUNCH_LOG_DIR}."
        fi
    fi

    SUMMARY_MIGRATION_STATUS="migrated"
    info "Legacy chronos install migrated."
}

# -----------------------------------------------
#Launchagent
# -----------------------------------------------
# Stops the already-running remount monitor/helper before this run starts
# touching the share mount, sparsebundle, or Time Machine destination, so the
# live agent cannot race a mount/detach/copy this run is in the middle of.
# setup_launchagent() re-bootstraps it later with its own bootout, so this is
# a no-op once the run reaches that point again.
pause_existing_launchagent() {
    if [[ ! -f "$LAUNCH_AGENT_PATH" ]]; then
        info "No existing LaunchAgent plist at ${LAUNCH_AGENT_PATH}; nothing to pause."
        return 0
    fi

    if run_as_root launchctl bootout "gui/${CONSOLE_UID}" "$LAUNCH_AGENT_PATH" >/dev/null 2>&1; then
        info "Paused existing remount agent before making changes."
    else
        info "Existing remount agent at ${LAUNCH_AGENT_PATH} was not loaded; nothing to pause."
    fi
}

setup_launchagent() {
    if [[ "$SETUP_LAUNCHAGENT" -ne 1 ]]; then
        SUMMARY_LAUNCHAGENT_STATUS="skipped"
        return 0
    fi

    local network_url_applescript
    network_url_applescript="$(escape_for_applescript "$NETWORK_URL")"

    info "Installing LaunchAgent helper assets."
    run_as_root mkdir -p "$HELPER_DIR"
    run_as_root chown "$CONSOLE_USER:$CONSOLE_GROUP" "$HELPER_DIR"
    run_as_root chmod 0750 "$HELPER_DIR"
    run_as_root mkdir -p "${CONSOLE_HOME}/Library/LaunchAgents" "$LAUNCH_LOG_DIR"
    run_as_root chown "$CONSOLE_USER:$CONSOLE_GROUP" "${CONSOLE_HOME}/Library/LaunchAgents" "$LAUNCH_LOG_DIR"
    run_as_root chmod 0755 "${CONSOLE_HOME}/Library/LaunchAgents" "$LAUNCH_LOG_DIR"

    write_file_atomically "$HELPER_SCRIPT_PATH" 0750 <<EOF
#!/bin/bash
set -euo pipefail
IFS=\$'\\n\\t'

LOG_FILE="${LAUNCH_LOG_DIR}/${APP_NAME}-remount.log"
LOCK_DIR="${LAUNCH_LOG_DIR}/${APP_NAME}-remount.lock"
GUI_MOUNT_STATE_FILE="${LAUNCH_LOG_DIR}/${APP_NAME}-gui-mount.state"
GUI_PROMPT_SEEN_FILE="${LAUNCH_LOG_DIR}/${APP_NAME}-gui-prompt.state"
GUI_MOUNT_COOLDOWN="${GUI_MOUNT_COOLDOWN}"
DISK_IMAGE_MOUNTER_APP="/System/Library/CoreServices/DiskImageMounter.app"
NETWORK_URL="${NETWORK_URL}"
SHARE_HOST="${SHARE_HOST}"
SHARE_PORT="${SHARE_PORT}"
DESTINATION="${DESTINATION}"
BUNDLE_PATH="${BUNDLE_PATH}"
VOLUME_NAME="${VOLUME_NAME}"
VOLUME_MOUNT_POINT="/Volumes/${VOLUME_NAME}"

timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}

log() {
    printf '[%s] [%s] %s\n' "\$(timestamp)" "\$1" "\$2" >>"\$LOG_FILE"
}

cleanup_lock() {
    if [[ -d "\$LOCK_DIR" ]] && [[ -f "\$LOCK_DIR/pid" ]]; then
        local owner_pid=""
        owner_pid="\$(cat "\$LOCK_DIR/pid" 2>/dev/null || true)"
        if [[ "\$owner_pid" == "\$\$" ]]; then
            rm -rf "\$LOCK_DIR" >/dev/null 2>&1 || true
        fi
    fi
}

acquire_lock() {
    if mkdir "\$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "\$\$" >"\$LOCK_DIR/pid"
        return 0
    fi

    local existing_pid=""
    existing_pid="\$(cat "\$LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ "\$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "\$existing_pid" 2>/dev/null; then
        log WARN "Another remount check is already running with pid \$existing_pid; skipping duplicate invocation"
        return 1
    fi

    # The pid file is missing/non-numeric/dead, which normally means the lock is
    # stale. But there is a narrow window right after mkdir succeeds and before
    # the pid file is written where another process would see exactly that same
    # state -- reaping the lock here would delete a lock that is not stale at
    # all, just mid-creation. Only reap locks whose directory is old enough that
    # this race cannot explain it.
    local dir_mtime=""
    local now=""
    dir_mtime="\$(/usr/bin/stat -f %m "\$LOCK_DIR" 2>/dev/null || printf '0')"
    now="\$(date +%s)"
    if [[ \$((now - dir_mtime)) -lt 30 ]]; then
        log WARN "Remount lock at \$LOCK_DIR is younger than 30s and likely mid-creation; not reaping it yet"
        return 1
    fi

    log WARN "Removing stale remount lock at \$LOCK_DIR"
    rm -rf "\$LOCK_DIR" >/dev/null 2>&1 || true

    if mkdir "\$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "\$\$" >"\$LOCK_DIR/pid"
        return 0
    fi

    log WARN "Unable to acquire remount lock at \$LOCK_DIR"
    return 1
}

is_mountpoint() {
    mount | awk -v t="\$1" '{ i = index(\$0, " on /"); if (i == 0) next; s = substr(\$0, i + 4); sub(/ \([^)]*\)\$/, "", s); if (s == t) found = 1 } END { exit found ? 0 : 1 }'
}

# Runs \`ls\` on \$1 in the background and kills it if it has not returned within
# \$2 seconds, so a dead SMB mount that still answers \`mount\`/\`stat\` metadata
# but blocks on real I/O cannot hang the helper.
probe_path_with_timeout() {
    local path="\$1"
    local timeout="\$2"
    local pid
    local elapsed=0

    # -la (not -ld): a readdir plus per-entry getattr forces real I/O, where a
    # bare stat of the vnode can still be answered from cache on a dead volume.
    /bin/ls -la "\$path" >/dev/null 2>&1 &
    pid=\$!

    while kill -0 "\$pid" 2>/dev/null; do
        if [[ "\$elapsed" -ge "\$timeout" ]]; then
            kill -KILL "\$pid" >/dev/null 2>&1 || true
            wait "\$pid" >/dev/null 2>&1 || true
            return 1
        fi
        sleep 1 || true
        elapsed=\$((elapsed + 1))
    done

    wait "\$pid"
}

path_is_accessible() {
    local target="\$1"

    [[ -e "\$target" ]] || return 1
    /bin/ls -ld "\$target" >/dev/null 2>&1
}

share_path_ready() {
    is_mountpoint "\$DESTINATION" || return 1

    # After the link drops, macOS leaves the SMB mountpoint in 'mount' output and
    # answers stat/ls from cached metadata, so the local checks below happily
    # report a dead share as healthy. Without this reachability gate, a stale
    # mount walks straight past the popup suppression and we ask DiskImageMounter
    # to open a sparsebundle whose backing store is gone -- which is exactly when
    # macOS puts up the "enter password" dialog.
    network_host_reachable || return 1

    path_is_accessible "\$DESTINATION"
}

bundle_path_ready() {
    [[ -d "\$BUNDLE_PATH" ]] || return 1
    path_is_accessible "\$BUNDLE_PATH" || return 1

    if [[ -f "\$BUNDLE_PATH/Info.plist" || -d "\$BUNDLE_PATH/bands" ]]; then
        return 0
    fi

    return 1
}

# Deliberately not a pipeline. This helper runs under 'set -o pipefail', and a
# 'grep -q' reader exits at its first match, leaving hdiutil to die of SIGPIPE;
# pipefail then promotes that 141 to the pipeline's status, so a successful match
# reported "not attached" whenever hdiutil outran the pipe buffer. That made the
# check fail intermittently, which left a stale attachment sitting behind a
# password dialog that could then never be satisfied.
bundle_is_attached() {
    local info=""
    info="\$(/usr/bin/hdiutil info 2>/dev/null || true)"
    [[ "\$info" == *"\$BUNDLE_PATH"* ]]
}

# Memoized briefly: share_path_ready() now consults this, and that runs inside
# per-second wait loops where an uncached 2s connect attempt would dominate.
NETWORK_REACHABLE_CACHE=""
NETWORK_REACHABLE_CACHE_AT=0

network_host_reachable() {
    local now=""
    now="\$(date +%s)"

    if [[ -n "\$NETWORK_REACHABLE_CACHE" ]] && [[ \$((now - NETWORK_REACHABLE_CACHE_AT)) -lt 5 ]]; then
        [[ "\$NETWORK_REACHABLE_CACHE" == "yes" ]]
        return
    fi

    NETWORK_REACHABLE_CACHE_AT="\$now"

    if /usr/bin/nc -z -w 2 "\$SHARE_HOST" "\$SHARE_PORT" >/dev/null 2>&1; then
        NETWORK_REACHABLE_CACHE="yes"
        return 0
    fi

    NETWORK_REACHABLE_CACHE="no"
    return 1
}

wait_for_mountpoint() {
    local target="\$1"
    local timeout="\$2"
    local elapsed=0

    while [[ "\$elapsed" -lt "\$timeout" ]]; do
        if is_mountpoint "\$target"; then
            return 0
        fi
        # sleep can be interrupted on macOS wake; with set -e this would terminate
        # the helper early, so we explicitly ignore non-zero exit codes here
        sleep 1 || true
        elapsed=\$((elapsed + 1))
    done

    return 1
}

trap cleanup_lock EXIT INT TERM HUP

if ! acquire_lock; then
    exit 0
fi

request_share_mount() {
    local elapsed=0

    log INFO "Share mount requested for \$NETWORK_URL"

    # Finder-backed mount APIs can raise user-facing connection dialogs when the
    # SMB/AFP host is offline, so skip GUI mount requests until the host answers.
    if ! network_host_reachable; then
        log WARN "Network host \$SHARE_HOST:\$SHARE_PORT is not reachable; skipping GUI mount request to avoid Finder popup"
        return 1
    fi

    /usr/bin/osascript >/dev/null 2>&1 <<OSA || true
try
    mount volume "${network_url_applescript}"
end try
OSA

    if ! share_path_ready; then
        # -g: mount the share without pulling a Finder window in front of whatever
        # the user is doing. Finder still performs the mount.
        /usr/bin/open -g "\$NETWORK_URL" >/dev/null 2>&1 || log WARN "Failed to request share mount for \$NETWORK_URL"
    fi

    while [[ "\$elapsed" -lt 30 ]]; do
        if share_path_ready && bundle_path_ready; then
            return 0
        fi
        sleep 1 || true
        elapsed=\$((elapsed + 1))
    done

    share_path_ready && bundle_path_ready
}

refresh_share_access() {
    if share_path_ready && bundle_path_ready; then
        log INFO "Share and sparsebundle path already reachable"
        return 0
    fi

    if ! network_host_reachable; then
        log WARN "Network host \$SHARE_HOST:\$SHARE_PORT is not reachable; leaving share disconnected to avoid Finder popup"
        return 1
    fi

    if is_mountpoint "\$DESTINATION"; then
        log WARN "Share mountpoint exists but is not fully reachable; requesting reconnect"
    fi

    request_share_mount
}

# An unanswered password dialog is invisible to every check above: the volume is
# not mounted, the image is not attached, so each pass concludes "mount it" and
# stacks another dialog on top of the one already waiting. These two guards are
# what stop a walk-away from turning into a screen full of prompts.
gui_mount_prompt_pending() {
    /usr/bin/pgrep -x DiskImageMounter >/dev/null 2>&1
}

gui_mount_cooldown_active() {
    local last=""
    local now=""

    [[ "\$GUI_MOUNT_COOLDOWN" -gt 0 ]] || return 1
    [[ -f "\$GUI_MOUNT_STATE_FILE" ]] || return 1

    last="\$(cat "\$GUI_MOUNT_STATE_FILE" 2>/dev/null || true)"
    [[ "\$last" =~ ^[0-9]+\$ ]] || return 1

    now="\$(date +%s)"
    [[ \$((now - last)) -lt "\$GUI_MOUNT_COOLDOWN" ]]
}

begin_gui_mount_cooldown() {
    date +%s >"\$GUI_MOUNT_STATE_FILE" 2>/dev/null || true
}

clear_gui_mount_cooldown() {
    rm -f "\$GUI_MOUNT_STATE_FILE" >/dev/null 2>&1 || true
}

# A dialog nobody answers blocks every future mount attempt, and there is no safe
# automatic way out: dismissing a prompt the user may be part-way through typing
# into is worse than waiting. So track how long one has been open and escalate to
# the user once, rather than sitting silent forever.
note_gui_prompt_seen() {
    [[ -f "\$GUI_PROMPT_SEEN_FILE" ]] && return 0
    date +%s >"\$GUI_PROMPT_SEEN_FILE" 2>/dev/null || true
}

clear_gui_prompt_seen() {
    rm -f "\$GUI_PROMPT_SEEN_FILE" >/dev/null 2>&1 || true
}

gui_prompt_stuck_threshold() {
    if [[ "\$GUI_MOUNT_COOLDOWN" -gt 0 ]]; then
        printf '%s' "\$((GUI_MOUNT_COOLDOWN * 2))"
    else
        printf '3600'
    fi
}

warn_if_gui_prompt_stuck() {
    local state=""
    local first=""
    local now=""
    local age=0

    [[ -f "\$GUI_PROMPT_SEEN_FILE" ]] || return 0
    state="\$(cat "\$GUI_PROMPT_SEEN_FILE" 2>/dev/null || true)"
    first="\${state%% *}"
    [[ "\$first" =~ ^[0-9]+\$ ]] || return 0

    now="\$(date +%s)"
    age=\$((now - first))
    [[ "\$age" -ge "\$(gui_prompt_stuck_threshold)" ]] || return 0

    log WARN "A sparsebundle password prompt has been open and unanswered for \${age}s; no remount can proceed until it is dismissed"

    # Notify once, then leave a marker so later runs only log.
    case "\$state" in
        *notified*) return 0 ;;
    esac

    /usr/bin/osascript -e "display notification \"A password prompt for \\\"${VOLUME_NAME}\\\" has been waiting \$((age / 60)) minutes. Dismiss the open dialogs and ${APP_NAME} will remount on its next check.\" with title \"${APP_NAME} needs attention\"" >/dev/null 2>&1 || true
    printf '%s notified\\n' "\$first" >"\$GUI_PROMPT_SEEN_FILE" 2>/dev/null || true
}

gui_mount_allowed() {
    if gui_mount_prompt_pending; then
        log WARN "A disk image password prompt is already open; not requesting another mount"
        return 1
    fi

    if gui_mount_cooldown_active; then
        log INFO "Still in cooldown after an unanswered password prompt; not requesting another mount"
        return 1
    fi

    return 0
}

mount_sparsebundle_with_diskimagemounter() {
    if [[ ! -d "\$DISK_IMAGE_MOUNTER_APP" ]]; then
        log WARN "DiskImageMounter app is missing at \$DISK_IMAGE_MOUNTER_APP"
        return 1
    fi

    log INFO "Attempting DiskImageMounter open for \$BUNDLE_PATH"
    if /usr/bin/open -g -a "\$DISK_IMAGE_MOUNTER_APP" "\$BUNDLE_PATH" >/dev/null 2>&1; then
        log INFO "DiskImageMounter open requested for \$BUNDLE_PATH"
        return 0
    fi

    log WARN "DiskImageMounter open failed for \$BUNDLE_PATH"
    return 1
}

mount_sparsebundle_with_open() {
    log INFO "Attempting Launch Services open fallback for \$BUNDLE_PATH"
    if /usr/bin/open "\$BUNDLE_PATH" >/dev/null 2>&1; then
        log INFO "Launch Services open fallback requested for \$BUNDLE_PATH"
        return 0
    fi

    log WARN "Launch Services open fallback failed for \$BUNDLE_PATH"
    return 1
}

mount_sparsebundle_with_hdiutil() {
    log INFO "Attempting hdiutil attach for \$BUNDLE_PATH"
    if /usr/bin/hdiutil attach -quiet -noautoopen -agentpass "\$BUNDLE_PATH" >/dev/null 2>&1; then
        log INFO "hdiutil attach succeeded for \$BUNDLE_PATH"
        return 0
    fi

    log WARN "hdiutil attach failed for \$BUNDLE_PATH"
    return 1
}

# Walks hdiutil's attached-image list for the entry matching \$BUNDLE_PATH and
# prints the first system-entities dev-entry it has, so a stuck attachment can
# be detached by device even when it never produced a usable mount point.
attached_device_for_bundle() {
    local info_plist_file=""
    local image_index=0
    local entity_index=0
    local current_path=""
    local dev_entry=""

    info_plist_file="\$(/usr/bin/mktemp "/tmp/${APP_NAME}-hdiutil.XXXXXX")" || return 1
    /usr/bin/hdiutil info -plist >"\$info_plist_file" 2>/dev/null || { rm -f "\$info_plist_file"; return 1; }
    /usr/bin/plutil -lint "\$info_plist_file" >/dev/null 2>&1 || { rm -f "\$info_plist_file"; return 1; }

    while true; do
        current_path="\$(/usr/libexec/PlistBuddy -c "Print :images:\${image_index}:image-path" "\$info_plist_file" 2>/dev/null || true)"
        [[ -n "\$current_path" ]] || break

        if [[ "\$current_path" == "\$BUNDLE_PATH" ]]; then
            entity_index=0
            while true; do
                dev_entry="\$(/usr/libexec/PlistBuddy -c "Print :images:\${image_index}:system-entities:\${entity_index}:dev-entry" "\$info_plist_file" 2>/dev/null || true)"
                [[ -n "\$dev_entry" ]] || break

                rm -f "\$info_plist_file"
                printf '%s\n' "\$dev_entry"
                return 0
            done

            break
        fi

        image_index=\$((image_index + 1))
    done

    rm -f "\$info_plist_file"
    return 1
}

# Best-effort by design: called from paths that are not conditionally guarded,
# so every command here must survive under set -e on its own.
detach_stale_attachment() {
    log WARN "Detaching stale sparsebundle attachment for \$BUNDLE_PATH"

    local dev=""
    dev="\$(attached_device_for_bundle || true)"

    if [[ -n "\$dev" ]]; then
        /usr/bin/hdiutil detach "\$dev" -quiet >/dev/null 2>&1 || /usr/bin/hdiutil detach "\$dev" -force -quiet >/dev/null 2>&1 || true
        return 0
    fi

    /usr/bin/hdiutil detach "\$VOLUME_MOUNT_POINT" -quiet >/dev/null 2>&1 || /usr/bin/hdiutil detach "\$VOLUME_MOUNT_POINT" -force -quiet >/dev/null 2>&1 || true
}

# Only called after share_path_ready has already succeeded, which implies the
# SMB host answered -- that reachability is what makes it safe to detach a
# stale attachment here instead of leaving it for a human to untangle.
# Returns 0 when the volume is mounted and healthy (caller should treat this as
# done); returns 1 when the caller should proceed to (re)request a mount,
# either because nothing is mounted/attached or because a stale attachment was
# just detached.
mounted_state_healthy() {
    if is_mountpoint "\$VOLUME_MOUNT_POINT"; then
        if probe_path_with_timeout "\$VOLUME_MOUNT_POINT" 10; then
            log INFO "Sparsebundle already mounted at \$VOLUME_MOUNT_POINT"
            return 0
        fi

        if gui_mount_prompt_pending; then
            log INFO "Volume at \$VOLUME_MOUNT_POINT is not answering reads, but a password prompt is open; leaving the attachment alone"
            return 1
        fi

        log WARN "Mounted volume at \$VOLUME_MOUNT_POINT is stale (share is reachable but the volume does not answer reads); detaching for remount"
        detach_stale_attachment
        return 1
    fi

    if bundle_is_attached; then
        # An attachment with no mounted volume is also what a sparsebundle looks
        # like while DiskImageMounter waits for someone to type the password.
        # Detaching here pulls the image out from under that dialog, so the
        # password the user eventually types lands on a detached image and fails
        # with "could not open" -- and the next run opens a fresh dialog over the
        # same wreckage. A prompt that is still up means wait, not clean up.
        if gui_mount_prompt_pending; then
            log INFO "Sparsebundle is attached with a password prompt still open; waiting for it to be answered instead of detaching"
            return 1
        fi

        log WARN "Sparsebundle is attached but its volume is not mounted; detaching stale attachment"
        detach_stale_attachment
        return 1
    fi

    return 1
}

attempt_sparsebundle_mount() {
    local attempt=1

    # Refreshing the share is safe to retry: it makes no GUI request while the
    # host is unreachable.
    while [[ "\$attempt" -le 3 ]]; do
        if refresh_share_access && share_path_ready && bundle_path_ready; then
            break
        fi

        log WARN "Share refresh attempt \${attempt}/3 failed for \$DESTINATION"
        sleep 5 || true
        attempt=\$((attempt + 1))
    done

    if ! share_path_ready || ! bundle_path_ready; then
        log WARN "Share or sparsebundle path is not reachable; not requesting a sparsebundle mount"
        return 1
    fi

    if mounted_state_healthy; then
        clear_gui_mount_cooldown
        return 0
    fi

    if ! gui_mount_allowed; then
        return 1
    fi

    # Exactly one GUI mount request per run. 'open' hands off to Launch Services
    # and returns 0 immediately, so retrying does not replace a pending password
    # dialog -- it stacks a second one behind it. The old loop did this up to
    # three times per run, every LAUNCH_INTERVAL seconds.
    if mount_sparsebundle_with_diskimagemounter || mount_sparsebundle_with_open || mount_sparsebundle_with_hdiutil; then
        if wait_for_mountpoint "\$VOLUME_MOUNT_POINT" 45 || bundle_is_attached; then
            clear_gui_mount_cooldown
            return 0
        fi

        if gui_mount_prompt_pending; then
            log WARN "Mount requested but not completed within 45s; assuming a password prompt is waiting for input"
            begin_gui_mount_cooldown
        else
            log WARN "Mount requested but not completed within 45s and no password dialog is open; will retry next interval"
        fi
        return 1
    fi

    log WARN "All sparsebundle mount methods failed for \$BUNDLE_PATH"
    return 1
}

log INFO "${APP_NAME} remount check started"

# Tracked once per run, independently of whether we get as far as a mount attempt.
if gui_mount_prompt_pending; then
    note_gui_prompt_seen
    warn_if_gui_prompt_stuck
else
    clear_gui_prompt_seen
fi

if ! share_path_ready || ! bundle_path_ready; then
    if refresh_share_access; then
        log INFO "Share mount confirmed at \$DESTINATION"
    else
        log WARN "Unable to confirm network share and sparsebundle path at \$DESTINATION"
        exit 0
    fi
else
    log INFO "Share already mounted and sparsebundle path is reachable"
fi

log INFO "Bundle path verified at \$BUNDLE_PATH"

if mounted_state_healthy; then
    clear_gui_mount_cooldown
    exit 0
fi

if attempt_sparsebundle_mount; then
    :
else
    log WARN "All sparsebundle mount attempts failed for \$BUNDLE_PATH"
fi

if wait_for_mountpoint "\$VOLUME_MOUNT_POINT" 5; then
    log INFO "Final mount confirmed at \$VOLUME_MOUNT_POINT"
elif bundle_is_attached; then
    log INFO "Final mount confirmed for attached bundle at \$BUNDLE_PATH"
else
    log WARN "Final mount not confirmed at \$VOLUME_MOUNT_POINT. If encrypted, ensure the password is available via Keychain for unattended remounts."
fi
EOF

    write_file_atomically "$MONITOR_SCRIPT_PATH" 0750 <<EOF
#!/bin/bash
set -euo pipefail
IFS=\$'\\n\\t'

LOG_FILE="${LAUNCH_LOG_DIR}/${APP_NAME}-remount-monitor.log"
HELPER_SCRIPT="${HELPER_SCRIPT_PATH}"
CHECK_INTERVAL="${LAUNCH_INTERVAL}"
HELPER_TIMEOUT_SECONDS="${LAUNCH_INTERVAL}"
BACKUP_ALERT_DAYS="${BACKUP_ALERT_DAYS}"
BACKUP_ALERT_STATE_FILE="${LAUNCH_LOG_DIR}/${APP_NAME}-backup-alert.state"

timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}

log() {
    printf '[%s] [%s] %s\n' "\$(timestamp)" "\$1" "\$2" >>"\$LOG_FILE"
}

# Must stay below the log() definition: this runs at load time, and calling log()
# before it exists kills the monitor outright under 'set -e'.
if [[ "\$HELPER_TIMEOUT_SECONDS" -lt 180 ]]; then
    log WARN "Helper timeout floored to 180s (requested \${CHECK_INTERVAL}s)"
    HELPER_TIMEOUT_SECONDS=180
fi

run_helper_once() {
    local helper_pid=""
    local helper_status=0
    local elapsed=0

    log INFO "Launching remount helper"
    /bin/bash "\$HELPER_SCRIPT" &
    helper_pid=\$!

    while kill -0 "\$helper_pid" 2>/dev/null; do
        if [[ "\$elapsed" -ge "\$HELPER_TIMEOUT_SECONDS" ]]; then
            log WARN "Remount helper exceeded timeout of \${HELPER_TIMEOUT_SECONDS}s; terminating pid \$helper_pid"
            kill "\$helper_pid" >/dev/null 2>&1 || true
            sleep 2 || true
            kill -0 "\$helper_pid" 2>/dev/null && kill -KILL "\$helper_pid" >/dev/null 2>&1 || true
            wait "\$helper_pid" >/dev/null 2>&1 || true
            log WARN "Remount helper timed out after \${HELPER_TIMEOUT_SECONDS}s"
            return 124
        fi

        sleep 1 || true
        elapsed=\$((elapsed + 1))
    done

    if wait "\$helper_pid"; then
        log INFO "Remount helper exited with code 0"
        return 0
    fi

    helper_status="\$?"
    log WARN "Remount helper exited with code \$helper_status"
    return "\$helper_status"
}

# Throttles both the "can't tell" WARN and the "too old" ERROR/notification to
# once per 24h, keyed off a single state file holding the epoch of the last
# alert. Without this, every check interval would either spam the log or, worse,
# stack a fresh user notification on top of ones nobody has dismissed yet.
backup_alert_throttled() {
    local last=""
    local now=""

    [[ -f "\$BACKUP_ALERT_STATE_FILE" ]] || return 1

    last="\$(cat "\$BACKUP_ALERT_STATE_FILE" 2>/dev/null || true)"
    [[ "\$last" =~ ^[0-9]+\$ ]] || return 1

    now="\$(date +%s)"
    [[ \$((now - last)) -lt 86400 ]]
}

record_backup_alert() {
    date +%s >"\$BACKUP_ALERT_STATE_FILE" 2>/dev/null || true
}

check_backup_age() {
    if [[ "\$BACKUP_ALERT_DAYS" -eq 0 ]]; then
        return 0
    fi

    local latest=""
    latest="\$(/usr/bin/tmutil latestbackup 2>/dev/null || true)"

    if [[ -z "\$latest" ]]; then
        if backup_alert_throttled; then
            return 0
        fi
        log WARN "Unable to determine latest Time Machine backup (tmutil latestbackup returned nothing); cannot verify backup freshness"
        record_backup_alert
        return 0
    fi

    local base=""
    base="\$(basename "\$latest")"
    base="\${base%.backup}"
    local stamp="\${base:0:10}"

    local backup_epoch=""
    backup_epoch="\$(/bin/date -j -f "%Y-%m-%d" "\$stamp" +%s 2>/dev/null || true)"

    if [[ -z "\$backup_epoch" ]]; then
        if backup_alert_throttled; then
            return 0
        fi
        log WARN "Unable to parse a backup date from latest Time Machine backup path '\$latest'; cannot verify backup freshness"
        record_backup_alert
        return 0
    fi

    local now=""
    now="\$(date +%s)"
    local age_days=\$(( (now - backup_epoch) / 86400 ))

    if [[ "\$age_days" -gt "\$BACKUP_ALERT_DAYS" ]]; then
        if backup_alert_throttled; then
            return 0
        fi
        log ERROR "Latest Time Machine backup is \${age_days} days old (threshold \${BACKUP_ALERT_DAYS}); backups are NOT landing"
        /usr/bin/osascript -e "display notification \"Latest Time Machine backup is \${age_days} days old (threshold \${BACKUP_ALERT_DAYS} days). Backups may not be landing.\" with title \"${APP_NAME} backup alert\"" >/dev/null 2>&1 || true
        record_backup_alert
        return 0
    fi

    # Fresh again: clear any prior throttle state so a future regression alerts
    # immediately instead of waiting out the last alert's 24h window.
    rm -f "\$BACKUP_ALERT_STATE_FILE" >/dev/null 2>&1 || true
}

handle_shutdown() {
    log INFO "${APP_NAME} remount monitor stopping"
    exit 0
}

trap handle_shutdown INT TERM HUP

# Keep one GUI-session monitor alive instead of depending on launchd to re-fire
# a short-lived job on StartInterval. In practice that timer has already proven
# unreliable here, while the helper itself is healthy and works when launched in
# the logged-in Aqua session. A persistent monitor keeps the Finder-sensitive
# mount logic in the same user context after login and through later reconnects.
# Sleep can return early after wake or signal delivery; that must not terminate
# the persistent monitor loop in a long-running user session.
log INFO "${APP_NAME} remount monitor started with interval \${CHECK_INTERVAL}s"

last_backup_check=0

while true; do
    run_helper_once || true

    now="\$(date +%s)"
    if [[ "\$last_backup_check" -eq 0 || \$((now - last_backup_check)) -ge 3600 ]]; then
        check_backup_age || true
        last_backup_check="\$now"
    fi

    log INFO "${APP_NAME} remount monitor sleeping for \${CHECK_INTERVAL}s"
    sleep "\$CHECK_INTERVAL" || true
done
EOF

    write_file_atomically "$LAUNCH_AGENT_PATH" 0644 <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LAUNCH_AGENT_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${MONITOR_SCRIPT_PATH}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
    </array>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>${LAUNCH_LOG_DIR}/${APP_NAME}-monitor.out</string>
    <key>StandardErrorPath</key>
    <string>${LAUNCH_LOG_DIR}/${APP_NAME}-monitor.err</string>
</dict>
</plist>
EOF

    run_as_root chown "$CONSOLE_USER:$CONSOLE_GROUP" "$HELPER_SCRIPT_PATH" "$MONITOR_SCRIPT_PATH" "$LAUNCH_AGENT_PATH"

    info "Attempting launchctl bootout for ${LAUNCH_AGENT_LABEL}."
    if run_as_root launchctl bootout "gui/${CONSOLE_UID}" "$LAUNCH_AGENT_PATH" >/dev/null 2>&1; then
        info "launchctl bootout completed for ${LAUNCH_AGENT_LABEL}."
    else
        info "launchctl bootout completed with no existing loaded instance for ${LAUNCH_AGENT_LABEL}."
    fi

    info "Attempting launchctl bootstrap for ${LAUNCH_AGENT_LABEL}."
    if run_as_root launchctl bootstrap "gui/${CONSOLE_UID}" "$LAUNCH_AGENT_PATH"; then
        info "launchctl bootstrap completed for ${LAUNCH_AGENT_LABEL}."
    else
        die "launchctl bootstrap failed for ${LAUNCH_AGENT_LABEL}."
    fi

    info "Attempting launchctl kickstart for ${LAUNCH_AGENT_LABEL}."
    if run_as_root launchctl kickstart -k "gui/${CONSOLE_UID}/${LAUNCH_AGENT_LABEL}"; then
        info "launchctl kickstart completed for ${LAUNCH_AGENT_LABEL}."
    else
        die "launchctl kickstart failed for ${LAUNCH_AGENT_LABEL}."
    fi

    SUMMARY_LAUNCHAGENT_STATUS="installed"
    info "LaunchAgent ${LAUNCH_AGENT_LABEL} installed as a persistent remount monitor."
}
# -----------------------------------------------
# Creation finished, start Backup
# -----------------------------------------------
start_first_backup() {
    if [[ "$START_FIRST_BACKUP" -ne 1 ]]; then
        SUMMARY_BACKUP_STATUS="skipped"
        return 0
    fi

    info "Starting first Time Machine backup."
    local output=""
    if output="$(run_as_root tmutil startbackup --auto 2>&1)"; then
        SUMMARY_BACKUP_STATUS="started"
        info "Time Machine backup initiation succeeded."
        if [[ -n "$output" ]]; then
            info "$output"
        fi
        return 0
    # Same pipefail/SIGPIPE hazard as bundle_is_attached: a 'grep -q' reader can
    # leave the writer with a broken pipe, and misreading this branch would die on
    # a backup that is merely already running. Match in-shell instead.
    elif [[ "$(printf '%s' "$output" | tr '[:upper:]' '[:lower:]')" == *"backup already in progress"* ]]; then
        SUMMARY_BACKUP_STATUS="already-running"
        warn "A Time Machine backup is already in progress."
    else
        die "Failed to start the first backup: ${output}"
    fi
}

print_summary() {
    cat <<EOF
Summary
-------
Sparsebundle path : ${BUNDLE_PATH}
Sparsebundle mode : ${SUMMARY_BUNDLE_STATUS}
Mounted at        : ${IMAGE_MOUNT_POINT}
LaunchAgent       : ${SUMMARY_LAUNCHAGENT_STATUS} (${LAUNCH_AGENT_LABEL})
Legacy migration  : ${SUMMARY_MIGRATION_STATUS}
Backup start      : ${SUMMARY_BACKUP_STATUS}
Keychain entry    : ${SUMMARY_KEYCHAIN_STATUS}
Mount window      : ${SUMMARY_MOUNT_WINDOW_STATUS}
Config file       : ${CONFIG_FILE:-none}
Log file          : ${LOG_FILE}
EOF

    if [[ "$ENABLE_ENCRYPTION" -eq 1 && "$SUMMARY_KEYCHAIN_STATUS" != "found" ]]; then
        printf '%s\n' "Note: encrypted sparsebundles may require the password to be saved in Keychain for unattended GUI remounts."
    fi
}
# -----------------------------------------------
# Main
# -----------------------------------------------
main() {
    init_bootstrap_log
    parse_args "$@"
    acquire_installer_lock

    info "${APP_NAME} ${VERSION} starting."
    validate_setup
    prepare_context
    finalize_log_file

    info "Console user: ${CONSOLE_USER}"
    info "Computer name: ${COMPUTER_NAME}"
    info "Bundle path: ${BUNDLE_PATH}"
    info "Destination mount: ${DESTINATION}"
    info "Filesystem: ${FILESYSTEM}"
    info "Encryption enabled: ${ENABLE_ENCRYPTION}"

    check_legacy_install

    if [[ "$LAUNCHAGENT_ONLY" -eq 1 ]]; then
        SUMMARY_BUNDLE_STATUS="unchanged"
        SUMMARY_BACKUP_STATUS="skipped-launchagent-only"
        info "LaunchAgent-only mode selected; skipping share mount, sparsebundle changes, MachineID writes, image mount, and Time Machine destination changes."
    else
        pause_existing_launchagent
        mount_network_share
        create_sparsebundle
        write_machine_id_plist
        mount_image
        configure_tm
        warn_if_keychain_entry_missing
    fi

    migrate_legacy_install
    setup_launchagent
    apply_mount_window_pref

    if [[ "$LAUNCHAGENT_ONLY" -ne 1 ]]; then
        start_first_backup
    fi

    print_summary
    RUN_SUCCEEDED=1
}

main "$@"
